# Copy to .env for local development. Placeholder values only: never commit a real .env.

# --- PostgreSQL (docker compose creates this database) ---
POSTGRES_USER=minerva
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=minerva

# --- API ---
MINERVA_DATABASE_URL=postgresql+psycopg://minerva:change-me-local-dev-only@localhost:5432/minerva
# Long random string used to derive session-token hashes. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
MINERVA_SESSION_SECRET=change-me-generate-a-random-value
MINERVA_ENV=development
MINERVA_COOKIE_SECURE=false
MINERVA_ALLOWED_ORIGINS=http://localhost:3000

# --- Compute limits ---
MINERVA_COMPUTE_TIMEOUT_SECONDS=10
MINERVA_COMPUTE_MEMORY_MB=1024
MINERVA_COMPUTE_MAX_CONCURRENCY=4
MINERVA_MAX_INPUT_CHARS=2000

# --- Web ---
MINERVA_API_URL=http://localhost:8100

# --- Chat assistant (optional; the workbench and handbook work without it) ---
# Full guide: docs/self-hosting.md
# off: chat disabled. ollama: your own Ollama server. scripted: deterministic stand-in (development only).
MINERVA_LLM_MODE=off
# Address of your Ollama server, as seen from the API process:
#   docker compose, Ollama on the same machine : http://host.docker.internal:11434
#   docker compose, Ollama on another machine  : http://<that-machine>:11434
#   API run without Docker, Ollama on this host: http://127.0.0.1:11434
# Inside a container "localhost" is the container itself, so never use it with docker compose.
MINERVA_LLM_BASE_URL=
# A model that supports tool calling, as listed by `ollama list` (e.g. the tuned `minerva` model)
MINERVA_LLM_MODEL=
# Seconds to wait for the model host (default 120)
MINERVA_LLM_TIMEOUT_SECONDS=120
# Let reasoning models "think" before replying: better sometimes, much slower.
MINERVA_LLM_THINK=false
# Drop reasoning that some models leak into their reply (delays streaming).
MINERVA_LLM_STRIP_THINKING=false
# "Add image" in chat: a vision-capable model on the same Ollama server that transcribes formulas from a
# picture (it may be the chat model if that accepts images). Empty: the button is hidden.
MINERVA_LLM_VISION_MODEL=

# Agent limits for one answer, and how much the server log says about each request. The log never
# contains expressions, tool arguments or results, or model text, at any setting.
MINERVA_AGENT_MAX_STEPS=6
MINERVA_AGENT_MAX_SECONDS=180
MINERVA_AGENT_MAX_TOOL_CALLS=12
# off | summary (one agent.completed line per request) | all (every trace event)
MINERVA_AGENT_EVENTS=summary
