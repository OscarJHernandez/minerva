{
  "name": "minerva",
  "private": true,
  "description": "Minerva monorepo root (JavaScript workspace). Python lives in a uv workspace, see pyproject.toml.",
  "license": "Apache-2.0",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
